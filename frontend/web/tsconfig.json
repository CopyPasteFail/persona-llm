{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["dom", "es2021"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    // Alias config (correct for a tsconfig that sits inside /web)
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    "allowJs": true,
    "noEmit": true,
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
