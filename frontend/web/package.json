{
  "name": "persona-llm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "rm -rf .next out .turbo",
    "dev": "next dev -p 3000",
    "dev:clean": "npm run clean && npm run dev",
    "dev:local": "NEXT_PUBLIC_API_URL=http://localhost:8080 next dev -p 3000",
    "dev:local:clean": "npm run clean && npm run dev:local",
    "build": "next build",
    "preview": "npx serve out -l 4173",
    "kill-port": "kill-port 3000"
  },
  "dependencies": {
    "next": "14.2.32",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.7",
    "typescript": "5.4.5",
    "firebase-tools": "14.15.1"
  }
}
