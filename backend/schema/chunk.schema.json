{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonaChunk",
  "type": "object",
  "required": ["id", "text", "metadata"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "required": ["employer", "year", "tech", "section", "type"],
      "properties": {
        "employer": {"type": "string"},
        "roles": {"type": "array", "items": {"type": "string"}},
        "role_primary": {"type": "string"},
        "role": {"type": "string"},
        "year": {"type": "integer"},
        "start_year": {"type": "integer"},
        "end_year": {"type": "integer"},
        "tech": {"type": "array", "items": {"type": "string"}},
        "type": {"type": "string", "enum": ["achievement", "experience"]},
        "section": {"type": "string"}
      },
      "oneOf": [
        {"required": ["role"]},
        {"required": ["roles", "role_primary"]}
      ]
    }
  }
}
