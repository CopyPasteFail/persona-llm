# Backend env example
# PERSONA_DIR=private/persona
PERSONA_NAME=Elvis Aaron Kennedy Junior
REGION=europe-west1
BUCKET_NAME=
INDEX_ID=<index_id>
INDEX_ENDPOINT_ID=<index_endpoint_id>
DEPLOYED_INDEX_ID=persona_deployment
CHUNKS_PATH=chunks-<sha>.jsonl.gz
DATAPOINTS_FILE=$(PRIVATE_DIR)/persona/data/datapoints.jsonl
# Optional datapoints overrides
# DATAPOINTS_SCHEMA=
# DATAPOINTS_INPUT=
# DATAPOINTS_MODEL=text-embedding-004
# DATAPOINTS_DIMENSIONS=3072
# DATAPOINTS_BATCH_SIZE=16
# DATAPOINTS_MAX_CHARS=2200
# DATAPOINTS_GZIP=0
# ME_MIN_REPLICAS=1
# ME_MAX_REPLICAS=1
API_KEY=
# JWT_SECRET=          # optional override for signing JWTs (defaults to API_KEY)
# JWT_SESSION_TTL_SECONDS=3600
MAX_INPUT_TOKENS=3000
MAX_OUTPUT_TOKENS=180
REQ_TIMEOUT_MS=20000
GOOGLE_APPLICATION_CREDENTIALS=$(HOME)/.config/persona-llm/vertex-ai-sa.json
