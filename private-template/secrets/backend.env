# Backend env example
# PERSONA_DIR=private/persona
PERSONA_NAME=Elvis Aaron Kennedy Junior
REGION=europe-west1
BUCKET_NAME=
INDEX_ID=<index_id>
INDEX_ENDPOINT_ID=<index_endpoint_id>
DEPLOYED_INDEX_ID=persona_deployment
CHUNKS_PATH=chunks-<sha>.jsonl.gz
VECTOR_BACKEND=local # 'local' or 'matching_engine'
LLM_BACKEND=vertex
OPS_AUTH=enabled
# OPS_SECRET=
# DATAPOINTS_FILE=$(PRIVATE_DIR)/persona/data/datasets/v1/datapoints.jsonl
DATAPOINTS_FILE="$PRIVATE_DIR/persona/data/datasets/$DATASET_VERSION/datapoints.jsonl"

# Optional datapoints overrides
# DATAPOINTS_SCHEMA=
# DATAPOINTS_INPUT=
# DATAPOINTS_MODEL=text-embedding-004
# DATAPOINTS_DIMENSIONS=3072
# DATAPOINTS_BATCH_SIZE=16
# DATAPOINTS_MAX_CHARS=2200
# DATAPOINTS_GZIP=0
# ME_MIN_REPLICAS=1
# ME_MAX_REPLICAS=1
API_KEY=
# JWT_SECRET=          # optional override for signing JWTs (defaults to API_KEY)
# JWT_SESSION_TTL_SECONDS=3600
MAX_INPUT_TOKENS=3000
MAX_OUTPUT_TOKENS=1000
# TOP_K=4  # retrieval depth used by chat/eval
THINKING_BUDGET_TOKENS=300  # optional; caps Gemini 2.5 "thinking" tokens
# INCLUDE_THOUGHTS=false
REQ_TIMEOUT_MS=20000
ENABLE_THINKING_GATING=true
# Stage 2 LLM gating (set ENABLE_LLM_CALL_GATING=true to activate threshold gating)
# ENABLE_LLM_CALL_GATING=false
# WEIGHTED_SCORE_THRESHOLD=0.62
# BM25_SCORE_THRESHOLD=3.0
# Retrieval hybrid scoring weights (should usually sum to 1.0)
# RETRIEVAL_VECTOR_WEIGHT=0.7
# RETRIEVAL_BM25_WEIGHT=0.3
GOOGLE_APPLICATION_CREDENTIALS=$(HOME)/.config/persona-llm/vertex-ai-sa.json
